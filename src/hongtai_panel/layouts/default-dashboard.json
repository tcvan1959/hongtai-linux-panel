    {"kind": "value", "x": 261, "y": 95, "width": 150, "height": 44, "source": "gpu_percent", "format": "{value:.0f}%", "font_size": 31, "bold": true},
    {"kind": "label", "x": 262, "y": 135, "width": 140, "height": 20, "text": "UTILIZATION", "font_size": 13, "color": "#64748b"},
